# Copy to .dev.vars for local development. Never commit .dev.vars.

# Your own Caliplaces developer app for local dev (type "web"), created at
# https://developer.caliplaces.com/apps with the redirect URI
#   http://localhost:5173/api/auth/callback
# Don't use the production app's credentials locally.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Any long random string (openssl rand -base64 32)
SESSION_SECRET=

# Cloudflare's always-pass Turnstile test secret
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional: R2 S3 API credentials for a dev bucket. Without them, local dev
# routes upload parts and downloads through the Worker against the local R2
# simulator.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Optional: a Resend API key. Without it, emails are printed to the wrangler
# console instead of sent. Preview them at http://localhost:5173/api/dev/emails
# RESEND_API_KEY=

# Optional: the signing secret of a Resend webhook pointed at this machine
# (through a tunnel), for bounces and spam complaints. Without it the webhook
# endpoint isn't there. See "Bounces and spam complaints" in README.md.
# RESEND_WEBHOOK_SECRET=

# APNS_KEY (Event mode's Live Activity pushes) isn't needed locally: wrangler
# dev can't reach Apple's push service, so try pushes on staging. Without it,
# the app still counts clips while it's open.

# Optional: Hop+ on the website, through Stripe, in test mode. Without these,
# the website doesn't sell Hop+. STRIPE_PRODUCT_ID is in wrangler.jsonc. To
# get webhooks locally, run the Stripe CLI:
#   stripe listen --forward-to localhost:8787/api/stripe/webhook
# and set STRIPE_WEBHOOK_SECRET to the whsec_… it prints.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
