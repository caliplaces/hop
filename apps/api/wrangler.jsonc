{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hop",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // One Worker serves both the API (/api/*) and the web app's static build.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/.well-known/apple-app-site-association",
      "/.well-known/assetlinks.json"
    ]
  },
  // Hourly clean-up of abandoned uploads and expired sessions.
  // Every 5 minutes: the new-clips digest. Hourly: cleanup. See src/index.ts.
  "triggers": { "crons": ["*/5 * * * *", "17 * * * *"] },

  // ---- Local development (wrangler dev) ----
  // Secrets and per-developer overrides live in .dev.vars (see .dev.vars.example).
  "vars": {
    "ENVIRONMENT": "development",
    "APP_URL": "http://localhost:5173",
    "EMAIL_FROM": "Hop (dev) <hello@onmyhop.com>",

    "REPORTS_EMAIL": "hello@onmyhop.com",
    "OIDC_ISSUER": "https://auth.caliplaces.com",
    // Each environment has its own Caliplaces developer app. For local dev, set
    // OIDC_CLIENT_ID and OIDC_CLIENT_SECRET in .dev.vars from your own dev app.
    "OIDC_CLIENT_ID": "",
    // The iPhone app's Caliplaces developer app (Native, no secret), shared by
    // every environment. OIDC_APP_REDIRECT picks where sign-in comes back to:
    // "https" (this site's callback, which only Hop can catch) or "scheme" (the
    // older custom scheme). Anything else turns app sign-in off.
    "OIDC_APP_CLIENT_ID": "399623629245054982",
    "OIDC_APP_REDIRECT": "scheme",
    "R2_BUCKET_NAME": "hop-dev",
    // Cloudflare's always-pass Turnstile test key.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    // Apple's push service, for Event mode's Live Activity. Each environment has
    // its own key, restricted to the app's bundle ID: sandbox here and on staging
    // (debug builds), production for TestFlight and App Store builds. The key
    // itself is the APNS_KEY secret (.dev.vars locally); without it nothing is pushed.
    // Android's pushes go through FCM with the FCM_SERVICE_ACCOUNT secret
    // instead (README: Android pushes), which needs no settings here.
    "APPLE_TEAM_ID": "XH66L5M6JJ",
    "APPLE_BUNDLE_ID": "com.onmyhop.app",
    "APPLE_APP_ID": "6834920854",
    "ANDROID_PACKAGE": "com.onmyhop.app",
    "APNS_ENVIRONMENT": "sandbox",
    "APNS_KEY_ID": "K4TQW3FWN6",
    // Hop+ on the website: the product in Stripe whose prices are sold, in
    // test mode here and on staging, live mode in production. The API key
    // and webhook signing secret are secrets (STRIPE_SECRET_KEY,
    // STRIPE_WEBHOOK_SECRET); without them the website doesn't sell Hop+.
    // The portal configuration is Hop's own (see the README).
    "STRIPE_PRODUCT_ID": "prod_VdnJFIpMsbAZlR",
    "STRIPE_PORTAL_CONFIGURATION": "bpc_1UcWDPGMF6pPdAKwEBeVEQ0D"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hop-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "hop-dev" }],
  // Per IP. Generous on purpose: a whole venue can share one Wi-Fi IP. Signing
  // in is rarer, so its limit is lower, but still allows a crowded venue. The
  // waitlist is also behind Turnstile, so its limit only stops floods.
  "ratelimits": [
    { "name": "UPLOAD_LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1011", "simple": { "limit": 20, "period": 60 } },
    { "name": "WAITLIST_LIMITER", "namespace_id": "1021", "simple": { "limit": 10, "period": 60 } },
    { "name": "PROFILE_LIMITER", "namespace_id": "1031", "simple": { "limit": 20, "period": 60 } },
    { "name": "REPORT_LIMITER", "namespace_id": "1041", "simple": { "limit": 10, "period": 60 } },
    // Per account: Stripe's own rate limit is shared with the account's other products.
    { "name": "BILLING_LIMITER", "namespace_id": "1051", "simple": { "limit": 5, "period": 60 } }
  ],

  "env": {
    "staging": {
      // Only serve on the custom domain, never on *.workers.dev or preview URLs.
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "staging.onmyhop.com", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_URL": "https://staging.onmyhop.com",
        "EMAIL_FROM": "Hop (staging) <hello@onmyhop.com>",

        "REPORTS_EMAIL": "hello@onmyhop.com",
        "OIDC_ISSUER": "https://auth.caliplaces.com",
        "OIDC_CLIENT_ID": "399581759521488902",
        "OIDC_APP_CLIENT_ID": "399623629245054982",
        "OIDC_APP_REDIRECT": "scheme",
        "R2_BUCKET_NAME": "hop-staging",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAGAzxw0pDT6tjGB4",
        "APPLE_TEAM_ID": "XH66L5M6JJ",
        "APPLE_BUNDLE_ID": "com.onmyhop.app",
        "APPLE_APP_ID": "6834920854",
        "ANDROID_PACKAGE": "com.onmyhop.app",
        "APNS_ENVIRONMENT": "sandbox",
        "APNS_KEY_ID": "K4TQW3FWN6",
        "STRIPE_PRODUCT_ID": "prod_VdnJFIpMsbAZlR",
        "STRIPE_PORTAL_CONFIGURATION": "bpc_1UcWDPGMF6pPdAKwEBeVEQ0D"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hop-staging",
          "database_id": "644503f2-678a-4c49-8956-bc9efc272465",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "hop-staging" }],
      "ratelimits": [
        {
          "name": "UPLOAD_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 300, "period": 60 }
        },
        {
          "name": "AUTH_LIMITER",
          "namespace_id": "1012",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "WAITLIST_LIMITER",
          "namespace_id": "1022",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "PROFILE_LIMITER",
          "namespace_id": "1032",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "REPORT_LIMITER",
          "namespace_id": "1042",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "BILLING_LIMITER",
          "namespace_id": "1052",
          "simple": { "limit": 5, "period": 60 }
        }
      ]
    },
    "production": {
      // Only serve on the custom domain, never on *.workers.dev or preview URLs.
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "onmyhop.com", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "production",
        "APP_URL": "https://onmyhop.com",
        "EMAIL_FROM": "Hop <hello@onmyhop.com>",

        "REPORTS_EMAIL": "hello@onmyhop.com",
        "OIDC_ISSUER": "https://auth.caliplaces.com",
        "OIDC_CLIENT_ID": "399569698213068806",
        "OIDC_APP_CLIENT_ID": "399623629245054982",
        "OIDC_APP_REDIRECT": "https",
        "R2_BUCKET_NAME": "hop-production",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAGAzsqAA1kSjsSnQ",
        "APPLE_TEAM_ID": "XH66L5M6JJ",
        "APPLE_BUNDLE_ID": "com.onmyhop.app",
        "APPLE_APP_ID": "6834920854",
        "ANDROID_PACKAGE": "com.onmyhop.app",
        // ANDROID_CERT_FINGERPRINTS, for the app's Digital Asset Links (README: How
        // the app signs in), gets Google Play's app signing key once Play shows it.
        // Only that one: never the upload key, which a thief could sign a lookalike with.
        "APNS_ENVIRONMENT": "production",
        "APNS_KEY_ID": "JNYA3Z4YF6",
        "STRIPE_PRODUCT_ID": "prod_Vd4BKOyA6xDfYn",
        "STRIPE_PORTAL_CONFIGURATION": "bpc_1Ud5zeGMF6pPdAKwIYxDQ7kl"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hop-production",
          "database_id": "61af8f57-7476-43f6-ab88-4ea427ee8d07",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "hop-production" }],
      "ratelimits": [
        {
          "name": "UPLOAD_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 300, "period": 60 }
        },
        {
          "name": "AUTH_LIMITER",
          "namespace_id": "1013",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "WAITLIST_LIMITER",
          "namespace_id": "1023",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "PROFILE_LIMITER",
          "namespace_id": "1033",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "REPORT_LIMITER",
          "namespace_id": "1043",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "BILLING_LIMITER",
          "namespace_id": "1053",
          "simple": { "limit": 5, "period": 60 }
        }
      ]
    }
  }
}
