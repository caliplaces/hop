{
  "name": "@hop/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "mkdir -p ../web/dist && wrangler dev --port 8787",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@hop/shared": "workspace:*",
    "@peculiar/x509": "2.2.0",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18",
    "oauth4webapi": "3.8.8",
    "reflect-metadata": "0.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261114.1",
    "@hop/typescript-config": "workspace:*",
    "drizzle-kit": "0.31.11",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  }
}
