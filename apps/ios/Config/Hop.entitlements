<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push, for updating Event mode's Live Activity while the phone is
	     locked. Xcode switches this to production when exporting for
	     TestFlight and the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Signing in comes back to an https page on these sites, which only
	     Hop can catch: each lists the app in its
	     apple-app-site-association file. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:onmyhop.com</string>
		<string>webcredentials:staging.onmyhop.com</string>
	</array>
	<!-- Shared with the widgets: the athlete's link for the QR code widget. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.onmyhop.app</string>
	</array>
</dict>
</plist>
