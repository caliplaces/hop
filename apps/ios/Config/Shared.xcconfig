// Settings shared by every target in Hop.xcodeproj.

IPHONEOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 6.0
SWIFT_APPROACHABLE_CONCURRENCY = YES

ENABLE_USER_SCRIPT_SANDBOXING = YES

// The app and its extensions must carry the same version.
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// Caliplaces' Apple Developer team. To sign with your own team instead, put
// `DEVELOPMENT_TEAM = <your team id>` in Config/Local.xcconfig (git ignores it).
DEVELOPMENT_TEAM = XH66L5M6JJ
#include? "Local.xcconfig"
