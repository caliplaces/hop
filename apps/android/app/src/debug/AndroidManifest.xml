<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds talk to staging, which signs in through the custom scheme.
    Any app can claim a scheme, so release builds don't: see
    HopServer.ALLOWS_CUSTOM_SCHEME. See the activity in src/main.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".auth.SignInCallbackActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.onmyhop.app" />
            </intent-filter>
        </activity>
    </application>
</manifest>
