<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: the QR code, a tap away. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_shortcut_qr"
        android:shortcutId="qr"
        android:shortcutLongLabel="@string/shortcut_qr_long"
        android:shortcutShortLabel="@string/shortcut_qr_short">
        <intent
            android:action="com.onmyhop.app.action.QR_CODE"
            android:targetClass="com.onmyhop.app.MainActivity"
            android:targetPackage="com.onmyhop.app" />
    </shortcut>
</shortcuts>
